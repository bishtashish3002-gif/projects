PORT=3000
CLIENT_ORIGIN=http://localhost:5500
DB_HOST=localhost
DB_PORT=3306
DB_NAME=student_utility_hub
DB_USER=root
DB_PASSWORD=replace-with-your-database-password
JWT_SECRET=replace-with-a-long-random-secret

# Password verification by email (Resend)
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Student Utility Hub <verify@your-verified-domain.example>

# Optional phone verification (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_FROM_NUMBER=+15551234567
